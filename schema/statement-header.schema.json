{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZeraBooks/quickbooks-online-bank-csv-spec/schema/statement-header.schema.json",
  "title": "Statement header sidecar",
  "description": "The printed figures from the statement a CSV came from. The validator uses them to prove the rows add up before the file goes into QuickBooks Online.",
  "type": "object",
  "required": ["bank", "account_last4", "account_type", "period_start", "period_end", "opening_balance", "closing_balance", "csv_files"],
  "properties": {
    "bank": {"type": "string", "description": "Fictional bank name."},
    "account_last4": {"type": "string", "pattern": "^[0-9]{4}$"},
    "account_type": {"enum": ["checking", "savings", "credit_card"]},
    "period_start": {"type": "string", "format": "date"},
    "period_end": {"type": "string", "format": "date"},
    "opening_balance": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$"},
    "closing_balance": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$"},
    "date_format": {"enum": ["MM/DD/YYYY", "DD/MM/YYYY"]},
    "csv_files": {"type": "array", "items": {"type": "string"}},
    "fictional": {"const": true}
  }
}
